{
  "$schema": "https://raw.githubusercontent.com/dongsheng123132/action-parity/v0.5.0/schema/action-parity.schema.json",
  "spec_version": "0.5.0",
  "application": {
    "id": "org.example.app.hello",
    "name": "打个招呼",
    "version": "0.1.0",
    "description": "The smallest possible U-King MiniApp. One action, no permissions, no network."
  },
  "conformance_targets": [
    "AP-1"
  ],
  "surfaces": [
    {
      "id": "miniapp",
      "kind": "gui",
      "required_for_parity": true,
      "description": "A text box and a button.",
      "reachability": "in-process"
    },
    {
      "id": "cli",
      "kind": "cli",
      "required_for_parity": true,
      "description": "U-King.exe action run app.hello.greet.say --json --input '{\"name\":\"世界\"}'",
      "reachability": "external"
    }
  ],
  "actions": [
    {
      "id": "app.hello.greet.say",
      "title": "Say hello to somebody",
      "description": "Return a greeting for the given name. Pure computation: no I/O, no network, no side effects.",
      "tags": [
        "demo"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "message"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 5000,
        "headless_evidence": "U-King.exe action run app.hello.greet.say --json --input <json>"
      },
      "bindings": [
        {
          "surface": "miniapp",
          "target": "uking-rpc:action/app.hello.greet.say"
        },
        {
          "surface": "cli",
          "target": "cli:action run app.hello.greet.say --json --input <json>"
        }
      ]
    }
  ]
}
